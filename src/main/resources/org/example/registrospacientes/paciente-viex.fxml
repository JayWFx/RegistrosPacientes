<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: #82C8E5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registrospacientes.PacienteController">

    <Label text="Nombre" textAlignment="JUSTIFY">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
    <TextField fx:id="txtNombres" promptText="Ingrese su nombre" />

    <Label text="Apellido">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
    <TextField fx:id="txtApellidos" promptText="Ingrese su apellido" />

    <HBox alignment="CENTER" spacing="20">
        <RadioButton fx:id="rbHombre" text="Hombre" />
        <RadioButton fx:id="rbMujer" text="Mujer" />
    </HBox>

    <Button onAction="#agregarOnClick" text="Ingresar" />

    <Label text="Pacientes Registrados:" />
    <ListView fx:id="lvPacientes" prefHeight="200" />

</VBox>
